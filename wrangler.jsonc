{
  "$schema": "web/node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "chicago-el-train-dashboard",
  "compatibility_date": "2026-10-12",
  // Static site only: serve Astro's build output, no server adapter needed.
  "assets": {
    "directory": "web/dist",
    "not_found_handling": "404-page"
  }
}
